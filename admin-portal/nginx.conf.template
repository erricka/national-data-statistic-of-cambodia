server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 400m;

    # The admin portal reaches the NIS server through this same address, so the
    # browser only ever talks to one site.
    location /api/ {
        proxy_pass ${NIS_SERVER_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Same-site requests: drop Origin so the server does not treat them as cross-site
        # (the public address differs from the internal one behind forwarding services).
        proxy_set_header Origin "";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
