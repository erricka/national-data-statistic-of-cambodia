# Copy this file to .env and fill it in. .env stays on your computer (it is in .gitignore).

# --- Data export (npm run export:data) -------------------------------------
# Your NIS PostgreSQL database. Use a read-only account.
DATABASE_URL=postgres://portal_reader:CHANGE_ME@your-db-host:5432/your-db-name

# Optional: the NIS portal server, so tables keep their official layout
NIS_API_URL=https://your-nis-server/api/nis-portal

# --- Website (npm run dev / build / deploy:pages) --------------------------
# Where statistical tables are loaded from:
#   static – the JSON snapshot in public/data (default; works on any static host)
#   api    – live from the NIS portal server (DTSI003); downloads use /files/{id}/download
VITE_DATA_MODE=static

# NIS portal server base URL (used when VITE_DATA_MODE=api)
VITE_API_BASE_URL=https://your-nis-server/api/nis-portal

# Link for the "Staff sign in" button (the existing admin portal)
VITE_ADMIN_URL=https://your-nis-admin-portal/login
