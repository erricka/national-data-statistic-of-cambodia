{
  "name": "national-data-statistic-of-cambodia",
  "private": true,
  "version": "1.0.0",
  "description": "National Data Statistics of Cambodia — public statistics portal for the National Institute of Statistics (NIS)",
  "type": "module",
  "scripts": {
