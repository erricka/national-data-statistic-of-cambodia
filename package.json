    "@svg-maps/cambodia": "2.0.0",
    "echarts": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=20"
  }
